{
  "name": "notevault-ui",
  "productName": "NoteVault",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "NoteVault's HTML/CSS/TypeScript interface. Runs inside an Electron shell; talks to the core over IPC.",
  "author": "Lessteps",
  "repository": "https://github.com/Lessteps/NoteVault",
  "scripts": {
    "dev": "vite",
    "postinstall": "node tools/copy-workout-assets.mjs",
    "prebuild": "node tools/copy-workout-assets.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run typecheck && vite build && electron-builder"
  },
  "build": {
    "appId": "com.notevault.app",
    "productName": "NoteVault",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "copyright": "Copyright © 2026 Lessteps. GPL-3.0-or-later",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Lessteps",
      "description": "Estudio, notas y gestión personal local-first",
      "synopsis": "Study, notes and personal management",
      "executableName": "notevault",
      "artifactName": "NoteVault-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "NoteVault-Setup-${version}.${ext}",
      "shortcutName": "NoteVault"
    },
    "portable": {
      "artifactName": "NoteVault-Portable-${version}.${ext}"
    },
    "deb": {
      "packageName": "notevault"
    }
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.48.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.1"
  },
  "homepage": "https://lessteps.com/",
  "bugs": "https://github.com/Lessteps/NoteVault/issues"
}
